# Copy to frontend/.env.production on the server before running `npm run build`.
# Vite bakes these values into the JS bundle at build time — there is no
# runtime env for a static build, so this file must exist before every build.

VITE_API_BASE_URL=https://7alpsglobal.com/api/v1
VITE_APP_URL=https://7alpsglobal.com
VITE_GOOGLE_MAPS_API_KEY=<same key as your local frontend/.env>
